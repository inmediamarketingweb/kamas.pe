  "scripts": {
    "start": "react-scripts start --no-source-maps start",
    "build": "react-scripts build --no-source-maps build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "optimize-images": "node scripts/optimize-images.js",
    "optimize-images:watch": "nodemon --watch public/assets/imagenes --ext jpg,jpeg,png --exec npm run optimize-images",
    "build:with-images": "npm run optimize-images && npm run build",
    "dev:with-images": "npm run optimize-images && npm run dev",
